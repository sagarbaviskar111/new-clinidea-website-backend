# MongoDB Atlas. The `clinidea` database is created automatically on first write.
MONGO_URI="mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/clinidea?retryWrites=true&w=majority"
DATABASE_URL="${MONGO_URI}"

# JWT Authentication Secret
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Application Environment & Port
NODE_ENV="development"
PORT=5000

# Storage Provider Configuration (options: local, s3, r2, gcs)
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# AWS S3 / Cloudflare R2 Credentials (Optional - required if STORAGE_PROVIDER=s3 or r2)
S3_BUCKET_NAME="clinidea-portal-storage"
S3_REGION="ap-south-1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"

# SMTP Email Service Configuration (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="notifications@clinidea.in"
EMAIL_PASS="YOUR_SMTP_PASSWORD"

# Vigithink External Tool Links
VIGITHINK_SAFETY_URL="https://clinidea.in/vigithink/login"
VIGITHINK_ETMF_URL="https://clinidea.in/vigithinketmf/login"
VIGITHINK_CDMS_URL="https://clinidea.in/vigithinkcdms/login"

# Production VPS (used by deploy.js / deploy_backend*.js / upload.js / fetch_logs.js / check_vps.js)
VPS_HOST="your-vps-ip"
VPS_USER="root"
VPS_PASSWORD="your-vps-password"
